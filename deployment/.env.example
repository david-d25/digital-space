# Copy to `.env` on the server. Not in git: this is the one file that differs
# between machines, and the only place secrets will live once there are any.

# Port the host's nginx proxies into. Bound to 127.0.0.1 by compose.
APP_PORT=8081

# Where the site is mounted. Empty for the root of a domain. If this is set,
# the web image must have been built with the same NEXT_PUBLIC_BASE_PATH —
# it is compiled into the bundle, not read at run time.
BASE_PATH=

# Which build is running. CI overwrites this on deploy; setting it by hand to
# an older commit is how a rollback works.
TAG=latest
